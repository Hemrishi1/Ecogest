# Server Port and Client URL
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Authentication & Encryption Secrets (MUST be at least 32 characters in production)
JWT_ACCESS_SECRET=ecogest_access_secret_production_ready_min_32_chars_2026
JWT_REFRESH_SECRET=ecogest_refresh_secret_production_ready_min_32_chars_2026
JWT_PREAUTH_SECRET=ecogest_preauth_secret_production_ready_min_32_chars_2026
TOTP_ENCRYPTION_KEY=ecogest_totp_encryption_key_256_bit_secure_32_chars

# Cloudflare Turnstile Secret Key
# Official Cloudflare test keys:
# Always Passes: 1x0000000000000000000000000000000AA
# Always Blocks: 2x0000000000000000000000000000000AB
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Two-Factor Authentication Enforcement (true or false)
REQUIRE_2FA=false

# Data Retention in Days (Submissions older than this are purged daily)
RETENTION_DAYS=365

# Nodemailer SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=password
EMAIL_FROM="Ecogest India <noreply@ecogestindia.com>"
EMAIL_TO=kanhaiya.mali@ecogestindia.com
